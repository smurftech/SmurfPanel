# udev rule for PCPanel Mini (STMicroelectronics 0483:a3c4)
# Grants local users in the 'uucp' group access to the device.
# Copy this file to /etc/udev/rules.d/99-pcpanel.rules and reload udev:
# sudo cp 99-pcpanel.rules /etc/udev/rules.d/
# sudo udevadm control --reload && sudo udevadm trigger

SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="a3c4", MODE="0660", GROUP="uucp", TAG+="uaccess"

# If you prefer to allow all users access (less secure), use MODE="0666" instead.
